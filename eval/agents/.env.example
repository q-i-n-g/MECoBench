# Copy to eval/agents/.env or export these variables in your shell.

# OpenAI-compatible endpoint used by gpt-5-mini, gpt-5-mini-2,
# gpt-5.4-nano, and text-embedding-3-large entries in models.json.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional local or hosted Qwen-compatible endpoints.
QWEN_API_KEY=
QWEN_8B_BASE_URL=http://localhost:8002/v1
QWEN_32B_BASE_URL=http://localhost:8001/v1

# MECoBench Simulator binary path used by src/start_unity_multi_8gpu.sh.
# UNITY_BIN is still accepted for backward compatibility.
MECOBENCH_SIMULATOR_BIN=/path/to/linux.x86_64
